{
  "name": "vane-dux-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "description": "Maintainer workspace for @mszr/vane-dux",
  "scripts": {
    "postinstall": "tsx scripts/install-git-hooks.ts --optional",
    "git:hooks:install": "tsx scripts/install-git-hooks.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "turbo run dev",
    "build": "pnpm run sdk:build",
    "typecheck": "pnpm run sdk:typecheck",
    "test": "pnpm run sdk:test",
    "audit": "tsx scripts/audit.ts",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run audit",
    "val": "pnpm run validate",
    "sdk:dev": "pnpm --dir vane-dux exec obuild --stub",
    "sdk:build": "pnpm --dir vane-dux exec obuild",
    "sdk:typecheck": "pnpm --dir vane-dux exec tsc --noEmit",
    "sdk:test": "pnpm --dir vane-dux exec vitest run --typecheck --passWithNoTests",
    "sdk:test:watch": "pnpm --dir vane-dux exec vitest --typecheck",
    "demo:minimal": "tsx scripts/not-implemented.ts demo:minimal W3",
    "demo:main": "tsx scripts/not-implemented.ts demo:main W3",
    "demo:comparisons": "tsx scripts/not-implemented.ts demo:comparisons W3",
    "publish:sdk:dry-run": "tsx scripts/not-implemented.ts publish:sdk:dry-run W4",
    "publish:sdk:patch": "tsx scripts/not-implemented.ts publish:sdk:patch W4",
    "publish:sdk:minor": "tsx scripts/not-implemented.ts publish:sdk:minor W4",
    "publish:sdk:major": "tsx scripts/not-implemented.ts publish:sdk:major W4",
    "publish:subtree:squash": "tsx scripts/not-implemented.ts publish:subtree:squash W4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-format": "^2.0.1",
    "jiti": "^2.7.0",
    "tsx": "^4.20.6",
    "turbo": "2.10.3",
    "typescript": "^5.8.3"
  }
}
