{
  "name": "vane-dux-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "description": "Maintainer workspace for @mszr/vane-dux",
  "scripts": {
    "postinstall": "tsx scripts/install-git-hooks.ts --optional",
    "git:hooks:install": "tsx scripts/install-git-hooks.ts",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "turbo run dev",
    "build": "pnpm run sdk:build",
    "typecheck": "pnpm run sdk:typecheck && pnpm run sdk:build && pnpm run demo:typecheck",
    "test": "pnpm run sdk:test",
    "audit": "tsx scripts/audit.ts",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run audit && pnpm run demo:e2e",
    "val": "pnpm run validate",

    "sdk:dev": "pnpm --dir vane-dux exec obuild --stub",
    "sdk:build": "pnpm --dir vane-dux exec obuild",
    "sdk:typecheck": "pnpm --dir vane-dux exec tsc --noEmit",
    "sdk:test": "pnpm --dir vane-dux exec vitest run --typecheck --passWithNoTests",
    "sdk:test:watch": "pnpm --dir vane-dux exec vitest --typecheck",

    "demo:main": "pnpm --dir sandbox/demo-main run dev",
    "demo:comparisons": "pnpm --dir sandbox/demo-comparisons run dev",
    "demo:typecheck": "pnpm --dir sandbox/demo-main run typecheck && pnpm --dir sandbox/demo-comparisons run typecheck",
    "demo:build": "pnpm --dir sandbox/demo-main run build && pnpm --dir sandbox/demo-comparisons run build",
    "demo:e2e:prod": "playwright test",
    "demo:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "demo:dev:lifecycle": "tsx scripts/dev-lifecycle.ts",
    "demo:e2e": "pnpm run sdk:build && pnpm run demo:build && pnpm run demo:e2e:prod && pnpm run demo:e2e:dev && pnpm run demo:dev:lifecycle",
    "fresh:smoke": "tsx scripts/fresh-smoke.ts",

    "publish:sdk:dry-run": "tsx scripts/publish.ts dry-run",
    "publish:sdk:patch": "tsx scripts/publish.ts patch",
    "publish:sdk:minor": "tsx scripts/publish.ts minor",
    "publish:sdk:major": "tsx scripts/publish.ts major",
    "publish:subtree:squash": "tsx scripts/publish.ts subtree"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@playwright/test": "^1.61.0",
    "eslint": "^10.6.0",
    "eslint-plugin-format": "^2.0.1",
    "jiti": "^2.7.0",
    "tsx": "^4.20.6",
    "turbo": "2.10.3",
    "typescript": "^6.0.3"
  }
}
